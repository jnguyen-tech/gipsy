# Copy this file to .env (in the same folder) and change what you like.
# Lines starting with # are notes.

# Your time zone (used for "what time is it" and Home Assistant).
TZ=America/Chicago

# Where Ollama is. Leave this alone when Ollama runs on this same PC.
OLLAMA_URL=http://host.docker.internal:11434

# Gipsy Hub. 0.0.0.0 = phones on your Wi-Fi and Tailscale can reach it.
# 127.0.0.1 = only this PC.
HUB_BIND=0.0.0.0
HUB_PORT=8765

# Open WebUI (http://localhost:3000). 127.0.0.1 = only this PC can open it.
# Change to 0.0.0.0 to open it from your phone too.
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000
# Set to False after you've made your own account so nobody else can sign up.
WEBUI_ALLOW_SIGNUP=True
OPEN_WEBUI_TAG=main

# Home Assistant (only starts with: docker compose --profile home up -d)
HA_BIND=0.0.0.0
HA_PORT=8123
HOME_ASSISTANT_TAG=stable
